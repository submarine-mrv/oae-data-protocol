        skos:prefLabel         "snowcat"@en .

<http://vocab.nerc.ac.uk/collection/L06/current/99/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L06::99";
        dc:date                "2024-09-26 12:59:16.0";
        dc:identifier          "SDN:L06::99";
